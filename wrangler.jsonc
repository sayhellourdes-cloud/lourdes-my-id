
{
  "$schema": "https://developers.cloudflare.com/workers/wrangler-schema.json",
  "name": "lourdes-my-id",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },e
  "d1_databases": [
    {
      "binding": "LOURDES_DB",
      "database_name": "lourdes-cms-db",
      "database_id": "3cec50c6aa8503abcacfcbcb68f750e8"
    }
  ]
}
