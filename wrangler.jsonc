
"d1_databases": [
  {
    "binding": "LOURDES_DB",
    "database_name": "lourdes-cms-db",
    "database_id": "ded288ae-b3f0-49f5-b701-00f6900d1579"
  }
]

{
  "$schema": "https://developers.cloudflare.com/workers/wrangler-schema.json",
  "name": "lourdes-my-id",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
